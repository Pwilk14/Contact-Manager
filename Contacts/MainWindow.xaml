<Window x:Class="Contacts.MainWindow"
        Closing="Window_closing"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Contacts"
        mc:Ignorable="d"
        Title="Contact Manager" Height="450" Width="800">
        
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="33*"/>
            <ColumnDefinition Width="367*"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="ViewContacts" Content="View Contacts" HorizontalAlignment="Left" Margin="30,24,0,0" VerticalAlignment="Top" Height="28" Width="169" Click="View_contact" Grid.ColumnSpan="2"/>
        <Button x:Name="AddContact" Content="Add Contatcs" HorizontalAlignment="Left" Margin="30,77,0,0" VerticalAlignment="Top" Height="28" Width="169" Click="AddContacts" Grid.ColumnSpan="2"/>
        <Button x:Name="SaveExit" Content="Save Changes" HorizontalAlignment="Left" Margin="30,129,0,0" VerticalAlignment="Top" Height="28" Width="169" Click="Save" Grid.ColumnSpan="2"/>
        <Border BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Left" Height="375" Margin="365,24,0,0" VerticalAlignment="Top" Width="335" Grid.Column="1">
            <ListView x:Name="Contact_List">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Vertical" Margin="5">

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Name: " FontWeight="Bold"/>
                                <TextBlock Text="{Binding Name}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Phone Number: " FontWeight="Bold"/>
                                <TextBlock Text="{Binding PhoneNumber}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Email: " FontWeight="Bold"/>
                                <TextBlock Text="{Binding Email}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <Button x:Name="EditContactBtn" Content="Edit" Width="60" Margin="5" Click="Edit_Contact"/>
                                <Button x:Name="RemoveContactBtn" Content="Remove" Width="60" Margin="5" Click="Remove_Contact"/>
                            </StackPanel>
                           
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
        <Label Content="Name:" HorizontalAlignment="Left" Margin="15,0,0,135" VerticalAlignment="Bottom" Grid.Column="1"></Label>
        <TextBox x:Name="TextName" HorizontalAlignment="Left" Height="29" Margin="66,272,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="173" Grid.Column="1"/>
        <TextBox x:Name="TextPhone" HorizontalAlignment="Left" Height="29" Margin="66,325,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="173" Grid.Column="1"/>
        <TextBox x:Name="TextEmail" HorizontalAlignment="Left" Height="29" Margin="66,370,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="173"  Grid.Column="1"/>
        <Label Content="Phone number:" HorizontalAlignment="Left" Margin="32,0,0,82" VerticalAlignment="Bottom" Grid.ColumnSpan="2"/>
        <Label Content="Email:" HorizontalAlignment="Left" Margin="16,0,0,37" VerticalAlignment="Bottom" Grid.Column="1"/>
       

    </Grid>
</Window>
